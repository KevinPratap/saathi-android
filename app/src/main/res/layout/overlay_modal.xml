<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_dark"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card_raised"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="16dp">

        <!-- Header with Warning Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_alert_triangle"
                android:contentDescription="Warning" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/threat_alert_header"
                android:textColor="@color/saathi_ruby"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:id="@+id/modalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/threat_alert_title_otp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/modalMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/threat_alert_msg_otp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- 3-Second Friction Hold Dismiss Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHoldToDismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/threat_btn_hold_dismiss"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            app:backgroundTint="@color/saathi_ruby_dark"
            app:cornerRadius="16dp" />

        <!-- Emergency Contact Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCallFamily"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/threat_btn_call_trusted"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:strokeColor="@color/saathi_border_highlight"
            app:strokeWidth="1dp"
            app:backgroundTint="@color/saathi_surface"
            app:cornerRadius="16dp" />

    </LinearLayout>

</FrameLayout>
