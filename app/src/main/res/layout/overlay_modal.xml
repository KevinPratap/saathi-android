<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_black"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/alert_yellow_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/modalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alert_title_otp_hi"
            android:textColor="@color/alert_red"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modalMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/alert_msg_otp_hi"
            android:textColor="@color/text_dark"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnHoldToDismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/alert_yellow_button"
            android:text="@string/btn_hold_to_dismiss"
            android:textColor="@color/alert_red_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCallFamily"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/call_family_blue"
            android:text="@string/btn_call_family"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
